# Copy to .env for local development. In deployment, set these as
# platform secrets/env vars — never commit a real .env file.

# Protects all /auth/* routes. Generate any long random string.
ADMIN_TOKEN=changeme

# Encrypts the session cookie at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=changeme

# Optional — defaults shown.
# SESSION_STORE_PATH=session.enc
# RATE_LIMIT_MIN_INTERVAL_SECONDS=3.0
# RATE_LIMIT_JITTER_SECONDS=2.0
# VOYAGER_REQUEST_TIMEOUT_SECONDS=15.0

# Used only by scripts/bootstrap_session.py, run locally — not read by the app itself.
API_URL=https://your-deployed-api.example.com
